<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>OrbHunt</RootNamespace>
    <Nullable>enable</Nullable>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Stride.Engine" Version="4.5.4-beta" />
    <PackageReference Include="Stride.AvaloniaUI" Version="4.5.4-beta" />
    <PackageReference Include="Stride.AvaloniaUI.Skia" Version="4.5.4-beta" />
    <PackageReference Include="Stride.AssetCompiler" Version="4.5.4-beta" IncludeAssets="build;buildTransitive" />
  </ItemGroup>
  <ItemGroup>
    <!-- The XAML compiler and the theme: Stride.AvaloniaUI is built against this exact Avalonia version -->
    <PackageReference Include="Avalonia" Version="[12.1.1]" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="[12.1.1]" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="[12.1.1]" />
  </ItemGroup>
</Project>
