<!--
  Stride.Graphics.targets
  
  Graphics API build-time configuration.
  
  This file runs AFTER project properties are evaluated and AFTER Microsoft.NET.Sdk.targets.
  Here we can access StrideGraphicsApiDependent which is set in the .csproj file.
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- ================================================================ -->
  <!-- Disable Graphics API Multi-Targeting for Single-API Platforms -->
  <!-- ================================================================ -->
  <!--
    Some platforms only support a single graphics API.
    If we're in an InnerBuild for such a platform, disable StrideGraphicsApiDependent.
    This must be in .targets because StrideGraphicsApiDependent is set in the .csproj.
  -->
  <PropertyGroup Condition="'$(StrideGraphicsApiDependent)' == 'true' And !('$(TargetFrameworks)' != '' and '$(TargetFramework)' == '')">
    <StrideGraphicsApiDependent Condition="'$(TargetFramework)' == '$(StrideFrameworkUWP)'">false</StrideGraphicsApiDependent>
    <StrideGraphicsApiDependent Condition="'$(TargetFramework)' == '$(StrideFrameworkiOS)'">false</StrideGraphicsApiDependent>
    <StrideGraphicsApiDependent Condition="'$(TargetFramework)' == '$(StrideFrameworkAndroid)'">false</StrideGraphicsApiDependent>
  </PropertyGroup>

  <!-- ================================================================ -->
  <!-- Output Path for Graphics API Dependent Builds -->
  <!-- ================================================================ -->
  <!--
    Projects with StrideGraphicsApiDependent=true build multiple times
    (once per API). Separate output paths prevent conflicts.
    This must be in .targets because StrideGraphicsApiDependent is set in the .csproj.
  -->
  <PropertyGroup Condition="'$(StrideGraphicsApiDependent)' == 'true'">
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    
    <IntermediateOutputPath>obj\$(Configuration)\$(TargetFramework)\$(StrideGraphicsApi)\</IntermediateOutputPath>
    <OutputPath>bin\$(Configuration)\$(TargetFramework)\$(StrideGraphicsApi)\</OutputPath>
    <CompilerGeneratedFilesOutputPath>obj\$(Configuration)\$(TargetFramework)\$(StrideGraphicsApi)</CompilerGeneratedFilesOutputPath>
    
    <!-- Disable ProduceReferenceAssembly to avoid path issues with custom IntermediateOutputPath -->
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    
    <!-- Disable StridePackAssets - Graphics API-dependent builds don't have assets to package -->
    <StridePackAssets>false</StridePackAssets>
  </PropertyGroup>

  <!-- ================================================================ -->
  <!-- Initialize Graphics API (Step 1) -->
  <!-- ================================================================ -->
  <!--
    PropertyGroups in .targets files ARE evaluated at import time (after project).
    So this CAN set StrideGraphicsApi and it WILL be visible to later PropertyGroups.
  -->
  <PropertyGroup Condition="'$(StrideGraphicsApi)' == ''">
    <StrideGraphicsApi>$(StrideDefaultGraphicsApi)</StrideGraphicsApi>
    <StrideGraphicsApi Condition="'$(DesignTimeBuild)' == 'true' And '$(StrideDefaultGraphicsApiDesignTime)' != ''">
      $(StrideDefaultGraphicsApiDesignTime)
    </StrideGraphicsApi>
  </PropertyGroup>

  <!-- ================================================================ -->
  <!-- Map Graphics API to Preprocessor Defines (Step 2) -->
  <!-- ================================================================ -->
  <!--
    These PropertyGroups execute in order AFTER StrideGraphicsApi is set above.
  -->
  <PropertyGroup Condition="'$(StrideGraphicsApi)' == 'Direct3D11'">
    <StrideGraphicsApiDefines>STRIDE_GRAPHICS_API_DIRECT3D;STRIDE_GRAPHICS_API_DIRECT3D11</StrideGraphicsApiDefines>
  </PropertyGroup>

  <PropertyGroup Condition="'$(StrideGraphicsApi)' == 'Direct3D12'">
    <StrideGraphicsApiDefines>STRIDE_GRAPHICS_API_DIRECT3D;STRIDE_GRAPHICS_API_DIRECT3D12</StrideGraphicsApiDefines>
  </PropertyGroup>

  <PropertyGroup Condition="'$(StrideGraphicsApi)' == 'Null'">
    <StrideGraphicsApiDefines>STRIDE_GRAPHICS_API_NULL</StrideGraphicsApiDefines>
  </PropertyGroup>

  <PropertyGroup Condition="'$(StrideGraphicsApi)' == 'OpenGL'">
    <StrideGraphicsApiDefines>STRIDE_GRAPHICS_API_OPENGL;STRIDE_GRAPHICS_API_OPENGLCORE</StrideGraphicsApiDefines>
  </PropertyGroup>

  <PropertyGroup Condition="'$(StrideGraphicsApi)' == 'OpenGLES'">
    <StrideGraphicsApiDefines>STRIDE_GRAPHICS_API_OPENGL;STRIDE_GRAPHICS_API_OPENGLES</StrideGraphicsApiDefines>
  </PropertyGroup>

  <PropertyGroup Condition="'$(StrideGraphicsApi)' == 'Vulkan'">
    <StrideGraphicsApiDefines>STRIDE_GRAPHICS_API_VULKAN</StrideGraphicsApiDefines>
  </PropertyGroup>

  <!-- ================================================================ -->
  <!-- Build Combined Defines String -->
  <!-- ================================================================ -->
  <!--
    Build UI defines first in a separate variable, then append both Graphics API
    and UI defines to DefineConstants in a single PropertyGroup.
    This prevents $(DefineConstants) from being evaluated multiple times with
    different values in multi-framework or multi-project contexts.
    
    CRITICAL: Only execute when StrideGraphicsApiDependent is true to avoid
    overwriting DefineConstants in non-Graphics projects during multi-project builds.
  -->
  <PropertyGroup Condition="'$(StrideGraphicsApiDependent)' == 'true'">
    <!-- Build the UI defines string -->
    <StrideUIDefines Condition="$(StrideUI.Contains('SDL'))">$(StrideUIDefines);STRIDE_UI_SDL</StrideUIDefines>
    <StrideUIDefines Condition="$(StrideUI.Contains('WINFORMS'))">$(StrideUIDefines);STRIDE_UI_WINFORMS</StrideUIDefines>
    <StrideUIDefines Condition="$(StrideUI.Contains('WPF'))">$(StrideUIDefines);STRIDE_UI_WPF</StrideUIDefines>
    
    <!-- Apply both Graphics API and UI defines in a single assignment -->
    <DefineConstants Condition="'$(StrideGraphicsApiDefines)' != ''">$(DefineConstants);$(StrideGraphicsApiDefines)</DefineConstants>
    <DefineConstants Condition="'$(StrideUIDefines)' != ''">$(DefineConstants);$(StrideUIDefines)</DefineConstants>
  </PropertyGroup>

</Project>
