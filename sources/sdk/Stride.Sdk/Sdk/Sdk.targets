<!--
  Stride.Sdk - Main SDK Targets File
  
  This file is imported at the end of project evaluation. It:
  1. Defines empty fallback targets (Build, Clean, etc.)
  2. Configures Stride-specific properties (platform detection, compiler control, etc.)
  3. Imports Microsoft.NET.Sdk.targets (defines CoreCompile, CopyFilesToOutputDirectory, etc.)
  4. Imports Stride-specific targets files that hook into SDK targets
  
  Import Order (critical for proper evaluation):
  1. Empty fallback targets (overridden by Microsoft.NET.Sdk later)
  2. Stride property configuration (OutputType, StrideCompilerTargetsEnable, etc.)
  3. Microsoft.NET.Sdk.targets (MUST come before our targets that reference SDK targets)
  4. Stride.Runtime.targets, AssemblyProcessor, Graphics, Packaging (can now use BeforeTargets/AfterTargets)
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- ================================================================ -->
  <!-- Default Empty Targets (Fallbacks) -->
  <!-- ================================================================ -->
  <!-- These provide fallbacks that are overridden by Microsoft.NET.Sdk.targets later.
       Required for projects that may skip compilation (StrideCompilerTargetsEnable=false) -->
  <Target Name="Build"/>
  <Target Name="Clean"/>
  <Target Name="ReBuild"/>
  <Target Name="Publish"/>
  <Target Name="GetTargetPath"/>
  <Target Name="GetNativeManifest"/>
  <Target Name="GetPackagingOutputs"/>

  <!-- ================================================================ -->
  <!-- Platform-Specific Build Configuration -->
  <!-- ================================================================ -->
  <PropertyGroup>
    <!-- On Android, everything is library (even Exe) -->
    <OutputType Condition="'$(TargetFramework)' == '$(StrideFrameworkAndroid)'">Library</OutputType>
    
    <!-- Detect if project is executable -->
    <StrideIsExecutable Condition="'$(OutputType)' == 'Exe'">true</StrideIsExecutable>
    <StrideIsExecutable Condition="'$(OutputType)' == 'WinExe'">true</StrideIsExecutable>
    
    <!-- Process scripts with AssemblyProcessor by default -->
    <StrideAssemblyProcessor Condition="'$(StrideScript)' == 'true'">true</StrideAssemblyProcessor>
  </PropertyGroup>

  <!-- ================================================================ -->
  <!-- Code Analysis Configuration -->
  <!-- ================================================================ -->
  <PropertyGroup Condition="'$(StrideCodeAnalysis)' == 'true'">
    <CodeAnalysisRuleSet>$(MSBuildThisFileDirectory)..\..\..\targets\Stride.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>

  <!-- ================================================================ -->
  <!-- Compiler Target Control -->
  <!-- ================================================================ -->
  <PropertyGroup>
    <!-- Disable compilation for Windows-only projects on non-Windows TFMs -->
    <StrideCompilerTargetsEnable Condition="'$(TargetFramework)' != '$(StrideFramework)' and 
                                             '$(TargetFramework)' == '$(StrideFrameworkWindows)' and 
                                             '$(StrideWindowsOnly)' == 'true'">false</StrideCompilerTargetsEnable>
    
    <!-- Skip unit tests if requested -->
    <StrideCompilerTargetsEnable Condition="'$(StrideSkipUnitTests)' == 'true' And 
                                             $(StrideOutputFolder.StartsWith('Tests'))">false</StrideCompilerTargetsEnable>
    
    <!-- Override language targets to disable build -->
    <LanguageTargets Condition="'$(StrideCompilerTargetsEnable)' == 'false'">$(MSBuildThisFileDirectory)..\..\..\targets\Stride.Core.DisableBuild.targets</LanguageTargets>
  </PropertyGroup>

  <!-- ================================================================ -->
  <!-- Documentation (docfx) Configuration -->
  <!-- ================================================================ -->
  <PropertyGroup Condition="'$(StrideBuildDoc)' == 'true'">
    <!-- docfx requires TargetFramework to be set -->
    <TargetFramework Condition="'$(TargetFramework)' == ''">$(TargetFrameworks.Split(';', StringSplitOptions.RemoveEmptyEntries)[0])</TargetFramework>
  </PropertyGroup>

  <!-- ================================================================ -->
  <!-- C++ Project Support -->
  <!-- ================================================================ -->
  <PropertyGroup Condition="'$(StrideProjectType)' == 'Cpp'">
    <OutputPath>$(OutDir)</OutputPath>
    <IntermediateOutputPath>$(IntDir)</IntermediateOutputPath>
  </PropertyGroup>
  
  <!-- Import C++ targets if needed -->
  <Import Condition="'$(StrideProjectType)' == 'Cpp' And '$(StrideCompilerTargetsEnable)' != 'false'" 
          Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />

  <!-- ================================================================ -->
  <!-- Workaround Targets -->
  <!-- ================================================================ -->
  
  <!-- Workaround: GetPackagingOutputs from UWP tries to build ProjectReference with current TFM -->
  <Target Name="_StrideRemoveTargetFrameworkBeforeGetPackagingOutputs" BeforeTargets="GetPackagingOutputs">
    <ItemGroup>
      <ProjectReferenceWithConfiguration>
        <UndefineProperties>%(ProjectReferenceWithConfiguration.UndefineProperties);TargetFramework</UndefineProperties>
      </ProjectReferenceWithConfiguration>
    </ItemGroup>
  </Target>

  <!-- Workaround: Fix UpToDateCheck with project.assets.json -->
  <Target Name="_GenerateCompileInputsProjectAssets" AfterTargets="_GenerateCompileInputs">
    <ItemGroup>
      <CustomAdditionalCompileInputs Include="$(ProjectAssetsFile)" />
    </ItemGroup>
  </Target>

  <!-- ================================================================ -->
  <!-- Import Base Microsoft.NET.Sdk Targets -->
  <!-- ================================================================ -->
  <!-- CRITICAL: Must be imported AFTER property configuration but BEFORE Stride target files.
       This ensures:
       1. Framework references are properly configured (needs properties set first)
       2. SDK targets (CoreCompile, CopyFilesToOutputDirectory) exist before our targets reference them -->
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" Condition="'$(StrideProjectType)' != 'Cpp'" />

  <!-- ================================================================ -->
  <!-- Import Stride-Specific Targets Files -->
  <!-- ================================================================ -->
  <!-- These must come AFTER Microsoft.NET.Sdk.targets so they can use BeforeTargets/AfterTargets -->
  
  <!-- Runtime project triggers (only when StrideRuntime=true) -->
  <Import Project="Stride.Runtime.targets" Condition="'$(StrideRuntime)' == 'true'" />
  
  <!-- Assembly processor integration -->
  <Import Project="Stride.AssemblyProcessor.targets" />
  
  <!-- Graphics API multi-targeting support -->
  <Import Project="Stride.GraphicsApi.targets" />
  
  <!-- Graphics API defines (must be after .NET SDK to modify DefineConstants) -->
  <Import Project="Stride.Graphics.targets" />
  
  <!-- Package generation and deployment -->
  <Import Project="Stride.Packaging.targets" />

  <!-- ================================================================ -->
  <!-- Shader File Configuration -->
  <!-- ================================================================ -->
  <!-- Mark shader files with code generators and make generated files dependent -->
  <ItemGroup>
    <Compile Update="**\*.sdsl.cs" DependentUpon="%(Filename)" />
    <None Update="**\*.sdsl" Generator="StrideShaderKeyGenerator" />
    <Compile Update="**\*.sdfx.cs" DependentUpon="%(Filename)" />
    <None Update="**\*.sdfx" Generator="StrideEffectCodeGenerator" />
  </ItemGroup>

  <!-- ================================================================ -->
  <!-- Extensibility Hook: After Stride SDK -->
  <!-- ================================================================ -->
  <!-- Projects can define CustomAfterStrideSdkTargets to inject custom logic -->
  <Import Project="$(CustomAfterStrideSdkTargets)" 
          Condition="'$(CustomAfterStrideSdkTargets)' != '' and Exists('$(CustomAfterStrideSdkTargets)')" />

</Project>

