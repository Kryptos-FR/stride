<Project>
  <Import Project="$([MSBuild]::GetDirectoryNameOfFileAbove($(MSBuildProjectDirectory), 'Directory.Build.props'))/sdk/Stride.Build.Sdk.MultiPlatform.Tests/Sdk/Sdk.props" />
  <PropertyGroup>
    <TargetFrameworks>$(StrideTestTargetFrameworks)</TargetFrameworks>
  </PropertyGroup>
  <PropertyGroup>
    <AssemblyName>Stride.AvaloniaUI.Native.Tests</AssemblyName>
    <RootNamespace>Stride.AvaloniaUI.Native.Tests</RootNamespace>
    <StrideCompileAssets>false</StrideCompileAssets>
    <StrideGraphicsRegression>true</StrideGraphicsRegression>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The tests drive the Stride platform for Avalonia, whose interfaces Avalonia marks as private APIs -->
    <AvaloniaAccessUnstablePrivateApis>true</AvaloniaAccessUnstablePrivateApis>
    <NoWarn>$(NoWarn);AVA3001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- The Avalonia thread, shared with the tests of the whole-frame Skia renderer -->
    <Compile Include="..\Stride.AvaloniaUI.Tests\Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\Stride.AvaloniaUI.Tests\Shared\Fonts\*.ttf;..\Stride.AvaloniaUI.Tests\Shared\Fonts\*.otf;..\Stride.AvaloniaUI.Tests\Shared\Fonts\*.ttc" Link="Shared\Fonts\%(Filename)%(Extension)" LogicalName="Fonts.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\tests\Stride.XunitRunner\Stride.XunitRunner.csproj" />
    <ProjectReference Include="..\..\..\engine\Stride.Engine\Stride.Engine.csproj" />
    <ProjectReference Include="..\..\..\engine\Stride.Graphics.Regression\Stride.Graphics.Regression.csproj" />
    <ProjectReference Include="..\Stride.AvaloniaUI\Stride.AvaloniaUI.csproj" />
    <ProjectReference Include="..\Stride.AvaloniaUI.Skia\Stride.AvaloniaUI.Skia.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Xunit.SkippableFact" />
  </ItemGroup>
  <Import Project="$(StrideRoot)sources/sdk/Stride.Build.Sdk.MultiPlatform.Tests/Sdk/Sdk.targets" />
</Project>
