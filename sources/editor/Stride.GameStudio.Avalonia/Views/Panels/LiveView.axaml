<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sd="http://schemas.stride3d.net/xaml/presentation"
             xmlns:pm="using:Stride.Editor.PlayMode"
             xmlns:local="using:Stride.GameStudio.Avalonia.Views.Panels"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="500"
             x:Class="Stride.GameStudio.Avalonia.Views.Panels.LiveView"
             x:DataType="pm:LivePanelViewModel">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Stride.Assets.Editor.Avalonia/Views/SceneEditorImages.axaml"/>
        <ResourceInclude Source="avares://Stride.Assets.Editor.Avalonia/Themes/PreviewImages.axaml"/>
        <ResourceInclude Source="avares://Stride.Core.Assets.Editor.Avalonia/Views/ImageResources.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <UserControl.Styles>
    <!-- The state of the game, in the header: green while it plays -->
    <Style Selector="Border.state">
      <Setter Property="Background" Value="#40808080"/>
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="Padding" Value="6,1"/>
    </Style>
    <Style Selector="Border.state.playing">
      <Setter Property="Background" Value="#FF388934"/>
    </Style>
    <Style Selector="Border.state.playing TextBlock">
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <!-- Once the game stopped, the last tree stays, greyed -->
    <!-- The notices over the tree -->
    <Style Selector="Border.notice">
      <Setter Property="Background" Value="#30E0A030"/>
      <Setter Property="BorderBrush" Value="#80E0A030"/>
      <Setter Property="BorderThickness" Value="0,1"/>
      <Setter Property="Padding" Value="6,4"/>
    </Style>
    <Style Selector="Border.notice.warning">
      <Setter Property="Background" Value="#40CA5100"/>
      <Setter Property="BorderBrush" Value="#A0CA5100"/>
    </Style>
    <Style Selector="Border.state.paused">
      <Setter Property="Background" Value="#FF2B6CB0"/>
    </Style>
    <Style Selector="Border.state.paused TextBlock">
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Border.state.notResponding">
      <Setter Property="Background" Value="#FFCA5100"/>
    </Style>
    <Style Selector="Border.state.notResponding TextBlock">
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="ListBox.stopped">
      <Setter Property="Opacity" Value="0.5"/>
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="2,1"/>
      <Setter Property="MinHeight" Value="20"/>
    </Style>
    <!-- A disabled entity is greyed -->
    <Style Selector="TextBlock.disabled">
      <Setter Property="Opacity" Value="0.5"/>
    </Style>
    <Style Selector="TextBlock.match">
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style Selector="ToggleButton.expander">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Width" Value="16"/>
      <Setter Property="Height" Value="16"/>
      <Setter Property="Focusable" Value="False"/>
    </Style>
    <!-- An expander shows only its arrow, expanded or not -->
    <Style Selector="ToggleButton.expander:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ToggleButton.expander:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
  </UserControl.Styles>
  <DockPanel>
    <!-- The header: this tab shows the running game, not the scene assets -->
    <Border DockPanel.Dock="Top" Padding="6,4" Background="#20388934">
      <DockPanel>
        <Border DockPanel.Dock="Right" Classes="state" Classes.playing="{Binding IsPlaying}" Classes.paused="{Binding IsPaused}" Classes.notResponding="{Binding IsNotResponding}">
          <TextBlock Name="StateText" Text="{Binding StateText}" FontSize="11"/>
        </Border>
        <TextBlock Name="HeaderText" Text="{sd:LocalizeString Running game, Context=Play}" FontWeight="Bold" VerticalAlignment="Center"
                   IsVisible="{Binding StoppedNotice, Converter={x:Static ObjectConverters.IsNull}}"/>
        <TextBlock Name="StoppedHeaderText" Text="{sd:LocalizeString Stopped game, Context=Play}" FontWeight="Bold" VerticalAlignment="Center" Opacity="0.7"
                   IsVisible="{Binding StoppedNotice, Converter={x:Static ObjectConverters.IsNotNull}}"/>
      </DockPanel>
    </Border>
    <!-- Why there is no live view, or how to start one -->
    <TextBlock DockPanel.Dock="Top" Name="Message" Text="{Binding Message}" TextWrapping="Wrap" Margin="6,4" Opacity="0.8"
               IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}"/>
    <!-- The game sent nothing for a few seconds: it may be busy, or stopped at a breakpoint -->
    <Border DockPanel.Dock="Top" Name="NotRespondingNotice" Classes="notice warning" IsVisible="{Binding ShowsNotResponding}">
      <StackPanel Spacing="4">
        <TextBlock TextWrapping="Wrap"
                   Text="{sd:LocalizeString 'The game has not answered for a few seconds. It may be busy loading, or stopped at a breakpoint of a debugger.', Context=Play}"/>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button Name="WaitButton" Content="{sd:LocalizeString Wait, Context=Play}" Command="{Binding WaitCommand}"/>
          <Button Name="EndGameButton" Content="{sd:LocalizeString End game, Context=Play}" Command="{Binding EndGameCommand}"
                  ToolTip.Tip="{sd:LocalizeString Ends the process of the game at once, Context=ToolTip}"/>
        </StackPanel>
      </StackPanel>
    </Border>
    <!-- The game runs another build of its code than the editor loaded -->
    <Border DockPanel.Dock="Top" Name="StaleNotice" Classes="notice" IsVisible="{Binding StaleNotice, Converter={x:Static ObjectConverters.IsNotNull}}">
      <StackPanel Spacing="4">
        <TextBlock TextWrapping="Wrap" Text="{Binding StaleNotice}"/>
        <Button Name="ReloadCodeButton" Content="{sd:LocalizeString Reload game assemblies, Context=Play}" Command="{Binding ReloadCodeCommand}"
                IsVisible="{Binding ReloadCodeCommand, Converter={x:Static ObjectConverters.IsNotNull}}"/>
      </StackPanel>
    </Border>
    <!-- A script's exception paused the game: which script, its entity, and the ways on -->
    <Border DockPanel.Dock="Top" Name="ScriptExceptionNotice" Classes="notice warning" IsVisible="{Binding ExceptionNotice, Converter={x:Static ObjectConverters.IsNotNull}}">
      <StackPanel Spacing="4">
        <TextBlock Name="ScriptExceptionText" TextWrapping="Wrap" Text="{Binding ExceptionNotice}"/>
        <TextBlock TextWrapping="Wrap" Opacity="0.8"
                   Text="{sd:LocalizeString 'The engine stopped this script; the rest of the game goes on when you resume. The Output has the stack.', Context=Play}"/>
        <WrapPanel Orientation="Horizontal">
          <Button Name="SelectExceptionEntityButton" Margin="0,0,6,4" Content="{sd:LocalizeString Select entity, Context=Play}" Command="{Binding SelectExceptionEntityCommand}"
                  ToolTip.Tip="{sd:LocalizeString Selects the entity of the script in this tab and shows it in the property grid, Context=ToolTip}"/>
          <Button Name="ResumeAfterExceptionButton" Margin="0,0,6,4" Content="{sd:LocalizeString Resume, Context=Play}" Command="{Binding Controls.PauseCommand}"/>
          <Button Name="StepAfterExceptionButton" Margin="0,0,6,4" Content="{sd:LocalizeString Step, Context=Play}" Command="{Binding Controls.StepCommand}"/>
          <Button Name="StopAfterExceptionButton" Margin="0,0,6,4" Content="{sd:LocalizeString Stop game, Context=Play}" Command="{Binding StopGameCommand}"/>
          <Button Name="DismissExceptionButton" Margin="0,0,6,4" Content="{sd:LocalizeString Dismiss, Context=Play}" Command="{Binding DismissExceptionCommand}"/>
        </WrapPanel>
      </StackPanel>
    </Border>
    <!-- Pause (Resume while paused), Step one frame, the time scale, and the game's frame rate: the game draws while paused -->
    <DockPanel DockPanel.Dock="Top" Name="PlayControls" Margin="2,2,2,0" DataContext="{Binding Controls}" x:DataType="pm:PlayControlsViewModel">
      <TextBlock DockPanel.Dock="Right" Name="FramesPerSecond" VerticalAlignment="Center" Margin="4,0" Opacity="0.8"
                 Text="{Binding FramesPerSecond, StringFormat={}{0:0} fps}" IsVisible="{Binding CanControl}"
                 ToolTip.Tip="{sd:LocalizeString The frame rate of the game; it goes on drawing while paused, Context=ToolTip}"/>
      <StackPanel Orientation="Horizontal" Spacing="2">
        <Button Name="PauseButton" Focusable="False" Background="Transparent" Padding="4" Command="{Binding PauseCommand}"
                ToolTip.Tip="{Binding PauseText}" ToolTip.ShowOnDisabled="True">
          <Panel>
            <Image Source="{StaticResource ImagePause}" Width="16" Height="16" IsVisible="{Binding !IsPaused}"/>
            <Image Source="{StaticResource ImagePlay}" Width="16" Height="16" IsVisible="{Binding IsPaused}"/>
          </Panel>
        </Button>
        <Button Name="StepButton" Focusable="False" Background="Transparent" Padding="4" Command="{Binding StepCommand}"
                ToolTip.Tip="{sd:LocalizeString Step one frame: one update of the fixed step then pause, Context=ToolTip}" ToolTip.ShowOnDisabled="True">
          <Image Source="{StaticResource ImageNext}" Width="16" Height="16"/>
        </Button>
        <ComboBox Name="TimeScale" VerticalAlignment="Center" MinWidth="70" Margin="4,0,0,0"
                  ItemsSource="{x:Static pm:PlayControlsViewModel.TimeScales}"
                  SelectedItem="{Binding TimeScale}"
                  IsEnabled="{Binding CanControl}"
                  ToolTip.Tip="{sd:LocalizeString The speed of the game time: it multiplies the time factor of the game, Context=ToolTip}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="x:Double">
              <TextBlock Text="{Binding StringFormat={}{0}×}"/>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>
    </DockPanel>
    <!-- The scene the game was started on, when it is not its default scene (Play this scene) -->
    <TextBlock DockPanel.Dock="Top" Name="PlayedScene" Text="{Binding SceneText}" TextWrapping="Wrap" Margin="6,0,6,2" Opacity="0.8"
               IsVisible="{Binding SceneText, Converter={x:Static ObjectConverters.IsNotNull}}"/>
    <!-- The game stopped: the tree below is its last one, greyed, and its entities have no values any more -->
    <Border DockPanel.Dock="Top" Name="StoppedNotice" Classes="notice" IsVisible="{Binding StoppedNotice, Converter={x:Static ObjectConverters.IsNotNull}}">
      <TextBlock Name="StoppedNoticeText" TextWrapping="Wrap" Text="{Binding StoppedNotice}"/>
    </Border>
    <!-- Why the game is paused, when the editor did not pause it -->
    <TextBlock DockPanel.Dock="Top" Name="PauseReason" Text="{Binding PauseText}" TextWrapping="Wrap" Margin="6,0,6,2" Opacity="0.8"
               IsVisible="{Binding PauseText, Converter={x:Static ObjectConverters.IsNotNull}}"/>
    <!-- The search, expand and collapse, and the number of entities -->
    <DockPanel DockPanel.Dock="Top" Margin="2">
      <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="4,0" Opacity="0.8"
                 Text="{Binding EntityCount, StringFormat={}{0} entities}"/>
      <Button DockPanel.Dock="Right" Focusable="False" Background="Transparent" Padding="4" Command="{Binding CollapseAllCommand}"
              ToolTip.Tip="{sd:LocalizeString Collapse all entities, Context=ToolTip}">
        <Image Source="{StaticResource ImageCollapseAllFolders}" Width="16" Height="16"/>
      </Button>
      <Button DockPanel.Dock="Right" Focusable="False" Background="Transparent" Padding="4" Command="{Binding ExpandAllCommand}"
              ToolTip.Tip="{sd:LocalizeString Expand all entities, Context=ToolTip}">
        <Image Source="{StaticResource ImageExpandAllFolders}" Width="16" Height="16"/>
      </Button>
      <TextBox Name="SearchBox" PlaceholderText="{sd:LocalizeString Search}" VerticalAlignment="Center"
               Text="{Binding SearchText, Delay=200}"
               ToolTip.Tip="{sd:LocalizeString Show the entities whose name contains this text, Context=ToolTip}"/>
    </DockPanel>
    <!-- The running scenes and entities: a flat list of the shown rows, so that it is virtualized; several rows can be
         selected, and the selected entities are sent about 5 times a second -->
    <ListBox Name="LiveTree"
             ItemsSource="{Binding Tree.Rows}"
             SelectedItems="{Binding SelectedItems}"
             SelectionMode="Multiple"
             Classes.stopped="{Binding !IsLive}"
             GotFocus="OnTreeGotFocus"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ContextMenu>
        <!-- On the selected rows: a right click selects the row under the pointer first -->
        <ContextMenu>
          <MenuItem Name="ShowInSceneEditorMenuItem" Header="{sd:LocalizeString Show in scene editor, Context=Menu}" Command="{Binding ShowInSceneEditorCommand}"/>
          <Separator/>
          <MenuItem Name="CopyNameMenuItem" Header="{sd:LocalizeString Copy name, Context=Menu}" Command="{Binding CopyNameCommand}"/>
          <MenuItem Name="CopyIdMenuItem" Header="{sd:LocalizeString Copy id, Context=Menu}" Command="{Binding CopyIdCommand}"/>
        </ContextMenu>
      </ListBox.ContextMenu>
      <ListBox.DataTemplates>
        <DataTemplate DataType="pm:LiveSceneItem">
          <StackPanel Orientation="Horizontal" Margin="{Binding Depth, Converter={sd:NumericToThickness}, ConverterParameter={sd:Thickness 16,0,0,0}}">
            <ToggleButton Classes="expander" IsChecked="{Binding IsExpanded}" IsVisible="{Binding HasChildren}">
              <Panel>
                <Path Data="M 4,2 L 10,7 L 4,12 Z" Fill="{DynamicResource SystemControlForegroundBaseMediumBrush}" IsVisible="{Binding !IsExpanded}"/>
                <Path Data="M 2,4 L 12,4 L 7,10 Z" Fill="{DynamicResource SystemControlForegroundBaseMediumBrush}" IsVisible="{Binding IsExpanded}"/>
              </Panel>
            </ToggleButton>
            <Border Width="16" IsVisible="{Binding !HasChildren}"/>
            <Image Source="{StaticResource SceneIcon}" Width="16" Height="16" Margin="2,0"/>
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0"/>
          </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="pm:LiveEntityItem">
          <StackPanel Orientation="Horizontal" Margin="{Binding Depth, Converter={sd:NumericToThickness}, ConverterParameter={sd:Thickness 16,0,0,0}}">
            <ToggleButton Classes="expander" IsChecked="{Binding IsExpanded}" IsVisible="{Binding HasChildren}">
              <Panel>
                <Path Data="M 4,2 L 10,7 L 4,12 Z" Fill="{DynamicResource SystemControlForegroundBaseMediumBrush}" IsVisible="{Binding !IsExpanded}"/>
                <Path Data="M 2,4 L 12,4 L 7,10 Z" Fill="{DynamicResource SystemControlForegroundBaseMediumBrush}" IsVisible="{Binding IsExpanded}"/>
              </Panel>
            </ToggleButton>
            <Border Width="16" IsVisible="{Binding !HasChildren}"/>
            <Image Source="{Binding ComponentTypeNames, Converter={local:LiveEntityIcon}}" Width="16" Height="16" Margin="2,0"/>
            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="4,0"
                       Classes.disabled="{Binding !IsEnabled}" Classes.match="{Binding IsMatch}"/>
            <!-- Made by the game at run time: no entity of a scene asset is its counterpart -->
            <TextBlock Text="{sd:LocalizeString spawned, Context=Play}" VerticalAlignment="Center" FontStyle="Italic" FontSize="11"
                       Foreground="{DynamicResource SystemControlForegroundAccentBrush}" IsVisible="{Binding IsSpawned}">
              <ToolTip.Tip>
                <TextBlock MaxWidth="360" TextWrapping="Wrap"
                           Text="{sd:LocalizeString 'The game created this entity at run time: no entity of the scene assets of the running scenes is its counterpart. Instances of a prefab keep the ids of the prefab, so several live entities can share an id; only the first that has the id of an entity of a scene is its counterpart, and the others are marked spawned.', Context=ToolTip}"/>
              </ToolTip.Tip>
            </TextBlock>
          </StackPanel>
        </DataTemplate>
      </ListBox.DataTemplates>
    </ListBox>
  </DockPanel>
</UserControl>
