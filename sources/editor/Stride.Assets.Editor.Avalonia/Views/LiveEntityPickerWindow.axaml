<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sd="http://schemas.stride3d.net/xaml/presentation"
        xmlns:pm="using:Stride.Assets.Editor.PlayMode"
        mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="560"
        x:Class="Stride.Assets.Editor.Avalonia.Views.LiveEntityPickerWindow"
        x:DataType="pm:LiveEntityPickerViewModel"
        Title="{sd:LocalizeString Select a live entity, Context=Title}"
        Width="420" Height="560"
        MinWidth="320" MinHeight="240"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <!-- The picker of a live reference: the entities of the running game under their scenes, with a search box and, when a
       component is picked, the components of the selected entity that have the type of the reference -->
  <DockPanel Margin="10">
    <StackPanel DockPanel.Dock="Bottom"
                Orientation="Horizontal" HorizontalAlignment="Right"
                Spacing="8" Margin="0,10,0,0">
      <Button x:Name="OkButton"
              Content="{sd:LocalizeString OK, Context=Button}"
              ToolTip.Tip="{sd:LocalizeString Set the reference in the running game, Context=ToolTip}"
              IsDefault="True"
              IsEnabled="{Binding CanPick}"
              Click="OnOkClick" MinWidth="80"/>
      <Button x:Name="CancelButton"
              Content="{sd:LocalizeString Cancel, Context=Button}"
              ToolTip.Tip="{sd:LocalizeString Cancel (Esc), Context=ToolTip}"
              IsCancel="True"
              Click="OnCancelClick" MinWidth="80"/>
    </StackPanel>
    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" TextWrapping="Wrap" Text="{Binding Message}"/>
    <TextBox x:Name="SearchBox"
             DockPanel.Dock="Top"
             Margin="0,0,0,6"
             PlaceholderText="{sd:LocalizeString Search entities..., Context=Watermark}"
             Text="{Binding SearchText, Mode=TwoWay}"/>
    <ListBox x:Name="ComponentList"
             DockPanel.Dock="Right" Width="160" Margin="6,0,0,0"
             IsVisible="{Binding ComponentType, Converter={x:Static ObjectConverters.IsNotNull}}"
             ItemsSource="{Binding Components}"
             SelectedItem="{Binding SelectedComponent, Mode=TwoWay}"
             DoubleTapped="OnDoubleTapped">
      <ListBox.ItemTemplate>
        <DataTemplate DataType="pm:LivePickerComponent">
          <TextBlock Text="{Binding DisplayName}"/>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <ListBox x:Name="EntityList"
             ItemsSource="{Binding Rows}"
             SelectionMode="Single"
             SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
             DoubleTapped="OnDoubleTapped"
             ContainerPrepared="OnRowPrepared">
      <ListBox.Styles>
        <Style Selector="ListBoxItem.scene TextBlock">
          <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="ListBoxItem">
          <Setter Property="MinHeight" Value="0"/>
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate DataType="pm:LivePickerRow">
          <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
