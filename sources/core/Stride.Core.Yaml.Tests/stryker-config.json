{
  "stryker-config": {
    "concurrency": 2,
    "mutation-level": "Standard",
    "additional-timeout": 15000,
    "configuration": "Release",
    "target-framework": "net10.0",
    "project": "Stride.Core.Yaml.csproj",
    "coverage-analysis": "perTest",
