<Project>
  <Import Project="$([MSBuild]::GetDirectoryNameOfFileAbove($(MSBuildProjectDirectory), 'Directory.Build.props'))/sdk/Stride.Build.Sdk/Sdk/Sdk.props" />
  <!-- The play agent, loaded into a game the editor plays by the startup hook (Stride.PlayMode.Hook): it tracks the running
       scenes and sends the tree, snapshots of the subscribed entities, the log and a heartbeat. Runtime only: it references
       the engine and no design-time assembly. Its snapshot codec (Snapshots/) is also what the editor reads them with. -->
  <PropertyGroup>
    <TargetFramework>$(StrideFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <StrideAssemblyProcessor>true</StrideAssemblyProcessor>
    <StrideAssemblyProcessorOptions>--auto-module-initializer --serialization</StrideAssemblyProcessorOptions>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\shared\SharedAssemblyInfo.cs">
      <Link>Properties\SharedAssemblyInfo.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Stride.Engine\Stride.Engine.csproj" />
    <ProjectReference Include="..\Stride.PlayMode.Protocol\Stride.PlayMode.Protocol.csproj" />
    <!-- Built with the agent: the editor ships both (Stride.PlayMode.Files.targets); the agent does not reference it -->
    <ProjectReference Include="..\Stride.PlayMode.Hook\Stride.PlayMode.Hook.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>
  <Import Project="$(StrideRoot)sources/sdk/Stride.Build.Sdk/Sdk/Sdk.targets" />
</Project>
