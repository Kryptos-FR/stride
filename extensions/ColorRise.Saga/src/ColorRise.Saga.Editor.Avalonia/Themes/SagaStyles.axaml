<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sd="http://schemas.stride3d.net/xaml/presentation"
                    xmlns:vm="using:ColorRise.Saga.Editor.ViewModels"
                    xmlns:views="using:ColorRise.Saga.Editor.Avalonia.Views">
  <!-- The look of Saga's editors; SagaEditorAvaloniaPlugin merges this dictionary into the application. -->

  <!-- The header color of a node, by what it stands for: the acts of the plot indigo, the scenarios and quests of an act teal,
       the dialogues of a scenario or quest orange; in a dialogue, lines slate, choices orange, branches purple, ends red. -->
  <views:SagaNodeBrushes x:Key="SagaNodeBrushes"
                         Act="#FF3949AB" Scenario="#FF00796B" Quest="#FF00897B" Dialogue="#FFEF6C00"
                         Line="#FF546E7A" Choices="#FFEF6C00" Branch="#FF7B1FA2" End="#FFC62828"
                         Default="#FF595656"/>
  <SolidColorBrush x:Key="SagaEntryBrush" Color="#FFFFD54F"/>

  <!-- Where the story played in the session is, on a node: an outline and a badge. The node the play is at blue (the timeline's
       cursor), the way it came pale blue, a scenario running or a quest active green, a quest offered amber, what is over grey,
       a quest failed red. -->
  <views:SagaPlayBrushes x:Key="SagaPlayBrushes"
                         Current="#FF42A5F5" Visited="#FF90CAF9" Running="#FF66BB6A" Offered="#FFFFCA28" Done="#FF9E9E9E" Failed="#FFEF5350"/>

  <!-- The story timeline: the acts indigo, the scenarios and quests teal (offered paler, the stages light, success green,
       failure red), the dialogues orange, what the game did yellow, slate and purple, the signals blue; the cursor blue, the
       steps after it dimmed, a step that no longer applies red, a step that plays differently since the replay an orange dot. -->
  <views:SagaTimelineBrushes x:Key="SagaTimelineBrushes"
                             Act="#FF3949AB" Scenario="#FF00796B" Offered="#FF4D8F88" Active="#FF00897B" Stage="#FF80CBC4"
                             Succeeded="#FF43A047" Failed="#FFE53935" Dialogue="#FFEF6C00" Choice="#FFFFB74D"
                             Event="#FFFFD54F" Variable="#FF90A4AE" Answer="#FFBA68C8" Signal="#FF4FC3F7"
                             SpanText="#FFF5F5F5" Header="#FF2B2B2B" AlternateLane="#10FFFFFF" Grid="#FF4A4A4A"
                             Cursor="#4042A5F5" Future="#90202020" FutureText="#FF808080"
                             Diverged="#50E53935" DivergedText="#FFEF5350" PlaysDifferently="#FFFFA726"/>

  <!-- A node of a Saga graph: what it is and its title in the header, its input on the left, its ways out on the right -->
  <DataTemplate x:Key="SagaNodeTemplate" x:DataType="vm:SagaGraphNodeViewModel">
    <Border BorderThickness="2" CornerRadius="4" BorderBrush="{Binding PlayMark, Converter={StaticResource SagaPlayBrushes}}">
      <StackPanel MinWidth="140" MaxWidth="260">
        <Border Background="{Binding Kind, Converter={StaticResource SagaNodeBrushes}}" CornerRadius="2,2,0,0" Padding="8,3">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock FontSize="10" Foreground="#C0FFFFFF" Text="{Binding Kind}"/>
              <TextBlock FontSize="10" FontWeight="Bold" Foreground="{StaticResource SagaEntryBrush}" Text="ENTRY" IsVisible="{Binding IsEntry}"/>
              <Border CornerRadius="2" Padding="4,0" Background="{Binding PlayMark, Converter={StaticResource SagaPlayBrushes}}"
                      IsVisible="{Binding PlayMark, Converter={x:Static ObjectConverters.NotEqual}, ConverterParameter={x:Static vm:SagaPlayMark.None}}">
                <TextBlock FontSize="10" FontWeight="Bold" Foreground="#FF1E1E1E">
                  <Run Text="{Binding PlayMark}"/>
                  <Run Text="{Binding PlayNote}"/>
                </TextBlock>
              </Border>
            </StackPanel>
            <TextBlock FontWeight="Bold" Foreground="#FFEBEBEB" TextTrimming="CharacterEllipsis" Text="{Binding Title}" ToolTip.Tip="{Binding Id}"/>
          </StackPanel>
        </Border>
        <Grid ColumnDefinitions="Auto, *" Margin="0,3">
          <sd:NodeGraphConnector Grid.Column="0" Margin="3,1" VerticalAlignment="Top" Slot="{Binding Input}" Direction="Input"/>
          <ItemsControl Grid.Column="1" ItemsSource="{Binding Outputs}" HorizontalAlignment="Right">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SagaGraphSlot">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <TextBlock Foreground="#FFEBEBEB" VerticalAlignment="Center" Margin="10,0,2,0" MaxWidth="200"
                             TextTrimming="CharacterEllipsis" Text="{Binding Name}"/>
                  <sd:NodeGraphConnector Margin="3,1" Slot="{Binding}" Direction="Output"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </StackPanel>
    </Border>
  </DataTemplate>
</ResourceDictionary>
