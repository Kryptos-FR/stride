    495c5e7888d35cebe3bab1ac5d847ea2: !SagaChoicesNodeCard
        Id: hub
        Name: hub
        Choices:
            bf0fef792cdea50470cf82723881f0bf:
                Text: Who is trapped?
                When: 
                HideWhenFalse: true
                Once: true
                Actions: 
                TargetId: who
            d305804d16d80c5c75ad78988fee8250:
                Text: I'll dig them out.
                When: quest.rescue.state == available
                HideWhenFalse: true
                Once: false
                Actions: quest.rescue.state = active
                TargetId: thanks
            7fbef1cd774e7efc2099ef9499912fc8:
                Text: The guild will pay the diggers.
                When: quest.rescue.state == active && sided_with == ""
                HideWhenFalse: false
                Once: false
                Actions: sided_with = "guild"
                TargetId: end
            8d094ec1cc1f29d43175d1afae1f5ffe:
                Text: Leave.
                When: 
                HideWhenFalse: true
                Once: false
                Actions: 
                TargetId: end
        Position: {X: 0.0, Y: 140.0}
    9f334c915a014bd5685ed853420ef29c: !SagaLineNodeCard
        Id: who
        Name: 
        SpeakerId: foreman
        Text: Three of my diggers. Old Bram too.
        Actions: 
        NextId: hub
