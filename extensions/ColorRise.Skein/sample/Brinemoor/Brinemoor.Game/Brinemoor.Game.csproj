<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Brinemoor</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- Stride's asset URL constants name a class after each folder, and the voice-over folders are language codes (en):
         C# warns about a type whose name is all lower case (docs/plugin-findings.md, finding 24) -->
    <NoWarn>$(NoWarn);CS8981</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Stride.Engine" Version="$(SkeinStrideVersion)" />
    <PackageReference Include="Stride.UI" Version="$(SkeinStrideVersion)" />
    <PackageReference Include="Stride.AssetCompiler" Version="$(SkeinStrideVersion)" IncludeAssets="build;buildTransitive" />
    <!-- The game references Skein's runtime, its UI package for the provided presenters and its audio package for the
         voice-over; the asset compiler and Game Studio find the companions -->
    <ProjectReference Include="..\..\..\src\ColorRise.Skein\ColorRise.Skein.csproj" />
    <ProjectReference Include="..\..\..\src\ColorRise.Skein.UI\ColorRise.Skein.UI.csproj" />
    <ProjectReference Include="..\..\..\src\ColorRise.Skein.Audio\ColorRise.Skein.Audio.csproj" />
  </ItemGroup>
</Project>
