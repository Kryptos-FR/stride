<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ColorRise.Skein.Editor.ViewModels"
             xmlns:views="using:ColorRise.Skein.Editor.Avalonia.Views"
             x:Class="ColorRise.Skein.Editor.Avalonia.Views.YarnScriptEditorView"
             x:DataType="vm:YarnScriptEditorViewModel">
  <views:YarnTextPane x:Name="TextPane" Buffer="{Binding TextBuffer}" FontFamily="Cascadia Code,Consolas,Menlo,DejaVu Sans Mono,monospace" FontSize="13" />
</UserControl>
