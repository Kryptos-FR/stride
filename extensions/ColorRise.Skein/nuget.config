<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Tied to the fork (docs/plugin-findings.md): the Stride packages of a local engine build of the checkout this folder
         sits in. Once a released Stride has the plugin model, nuget.org serves them and this source goes. -->
    <add key="stride-dev" value="../../bin/packages" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
      <package pattern="Stride.GNU.*" />
      <package pattern="Stride.Mono.*" />
      <package pattern="Stride.Dependencies.*" />
    </packageSource>
    <packageSource key="stride-dev">
      <package pattern="Stride" />
      <package pattern="Stride.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
