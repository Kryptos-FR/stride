<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Thornwick</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- Game Studio shows the <userdoc> text of the scripts' properties from the documentation file that the build copies
         beside the startup head's output (Thornwick.Game.xml) -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Stride.Engine" Version="$(TesseraStrideVersion)" />
    <PackageReference Include="Stride.AssetCompiler" Version="$(TesseraStrideVersion)" IncludeAssets="build;buildTransitive" />
    <!-- The runtime of Tessera; the asset compiler and Game Studio find its companions -->
    <ProjectReference Include="..\..\..\src\ColorRise.Tessera\ColorRise.Tessera.csproj" />
  </ItemGroup>
</Project>
