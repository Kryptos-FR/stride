<Project>
  <!--
    ColorRise.Tessera builds against Stride through packages only, as any third party would, and against nothing else of the
    repository it sits in today: this file, Directory.Build.targets and nuget.config are its own, so that the folder can move to
    a repository of its own.

    TesseraStrideVersion is the Stride version to build against. Set another one in Directory.Build.local.props (git-ignored;
    copy Directory.Build.local.props.example).
  -->
  <Import Project="Directory.Build.local.props" Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.local.props')" />

  <PropertyGroup>
    <!-- What a local build of the Stride engine packs today: no released Stride has the plugin model Tessera uses -->
    <TesseraStrideVersion Condition="'$(TesseraStrideVersion)' == ''">4.5.4-dev</TesseraStrideVersion>
    <!-- The Avalonia version must be the one Game Studio ships with -->
    <TesseraAvaloniaVersion Condition="'$(TesseraAvaloniaVersion)' == ''">12.1.1</TesseraAvaloniaVersion>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- A prerelease while no released Stride has the plugin model: the packages depend on a development Stride -->
    <Version>0.1.0-dev</Version>
    <Authors>Color-Rise</Authors>
    <Company>Color-Rise</Company>
    <Copyright>Copyright (c) Color-Rise</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Kryptos-FR/stride/tree/feature/colorrise-tessera/extensions/ColorRise.Tessera</PackageProjectUrl>
    <!-- dotnet pack puts the packages in one folder, the feed a game outside this folder restores them from -->
    <PackageOutputPath>$(MSBuildThisFileDirectory)bin/packages/</PackageOutputPath>
  </PropertyGroup>

  <!-- The packages carry the documentation of their public types -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.Replace('\', '/').Contains('/src/'))">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- A parameter whose name says it all has no tag, and the constructor of a view or of a service no summary -->
    <NoWarn>$(NoWarn);CS1573;CS1591</NoWarn>
  </PropertyGroup>

  <!--
    Without a RuntimeIdentifier, Stride picks the Windows platform and Direct3D11, even on Linux or macOS. An engine built on
    those hosts has only the Vulkan Stride.Graphics, so the projects here would load assemblies that need a Vortice.Vulkan they
    were not given (Saga's finding 3, as Skein's plugin-findings.md records it).
  -->
  <PropertyGroup Condition="'$(StrideGraphicsApi)' == '' And !$([MSBuild]::IsOSPlatform('Windows'))">
    <StrideGraphicsApi>Vulkan</StrideGraphicsApi>
  </PropertyGroup>
</Project>
