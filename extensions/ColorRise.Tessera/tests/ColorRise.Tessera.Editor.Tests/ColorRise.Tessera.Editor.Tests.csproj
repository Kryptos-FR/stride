<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>ColorRise.Tessera.Editor.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- The editor's experimental plugin API, as in the editor packages, and its test kit (STREXP011) -->
    <NoWarn>$(NoWarn);STREXP001;STREXP003;STREXP006;STREXP011</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <!-- Stride's test kit for the view models of editor plugins: a session opened the way Game Studio opens one, without its windows -->
    <PackageReference Include="Stride.Assets.Editor.Testing" Version="$(TesseraStrideVersion)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\ColorRise.Tessera.Editor\ColorRise.Tessera.Editor.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
